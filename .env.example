# ── Postgres / Supabase ────────────────────────────────────
# Choose one mode below (remote Supabase cloud or local Supabase CLI).

# ── Mode 1: Remote Supabase (default) ──────────────────────
# Create a project at https://supabase.com, then paste your
# connection strings and anon / service_role keys.
#
# Supabase Postgres — pooled (runtime) and direct (migrations)
# See: https://supabase.com/docs/guides/database/connecting-to-postgres
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth / public client
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Mode 2: Local Supabase (brew install supabase/tap/supabase && supabase start) ──
# Uncomment this block and comment the remote block above.
# Email confirmations are disabled — sign-ups work without an SMTP provider.
# Emails are captured in Mailpit at http://127.0.0.1:54324.
#
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ── Mode 3: Docker (docker compose up) ─────────────────────
# Uncomment these for self-hosted Postgres (no Supabase cloud needed for the DB).
# Auth still requires a Supabase project (free tier) or self-hosted Supabase.
#
# DATABASE_URL="postgresql://postgres:postgres@db:5432/morningmoney"
# DIRECT_URL="postgresql://postgres:postgres@db:5432/morningmoney"

# ── Public site URL ────────────────────────────────────────
# Used for password reset redirects, Stripe checkout URLs, and
# email unsubscribe links. Vercel auto-sets NEXT_PUBLIC_VERCEL_URL
# as a fallback. Required for production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── AWS S3 (announcement PDFs) ──────────────────────────────
# Optional. If omitted, PDFs are stored via asx:// URL references.
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Resend (transactional email) ────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="Morning Money <daily@morning-money.app>"

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""

# ── Cron / worker shared secret ─────────────────────────────
# Used to secure the daily digest endpoint.
# Generate: openssl rand -hex 32
CRON_SECRET=""
