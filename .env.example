# ── User ─────────────────────────────────────────────────────
# The email used to auto-create the single local user
LOCAL_USER_EMAIL=you@email.com

# ── Postgres ─────────────────────────────────────────────────
# Docker:
#   DATABASE_URL="postgresql://postgres:postgres@db:5432/morningmoney"
#   DIRECT_URL="postgresql://postgres:postgres@db:5432/morningmoney"
#
# Local (without Docker):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"
#   DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"

# ── AI Analysis — Anthropic API (recommended) ──────────────
# Set ANTHROPIC_API_KEY to use Claude instead of local Ollama.
# Model options: claude-sonnet-4-20250514, claude-haiku-3-5-20251022
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── AI Analysis — local LLM via Ollama (fallback) ──────────
# Used when ANTHROPIC_API_KEY is not set.
# For an external Ollama instance:
#   OLLAMA_BASE_URL=http://192.168.1.100:11434
# Model: gemma3:12b (default), mistral:7b, llama3.2:3b, etc.
# Pull the model on first run: docker compose exec ollama ollama pull gemma3:12b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# Analysis complexity: plain | informed | professional
ANALYSIS_COMPLEXITY=plain

# ── Email — SMTP (default: Mailpit in docker-compose) ───────
# Mailpit captures all emails — view at http://localhost:8025
# To send real emails, swap to your own SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password
#   SMTP_FROM=Morning Money <you@gmail.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Morning Money <daily@localhost>

# ── Cron / worker shared secret ─────────────────────────────
# Used to secure the daily digest endpoint.
# Generate: openssl rand -hex 32
CRON_SECRET=""
