# ── App mode ────────────────────────────────────────────────
# "public" = full SaaS mode (requires Supabase, Stripe, AWS)
# "local"  = self-hosted / Docker mode (no auth, no payments)
NEXT_PUBLIC_APP_MODE=local

# Used in local mode to auto-create a single user on first run
LOCAL_USER_EMAIL=you@email.com

# ── Postgres ─────────────────────────────────────────────────
# Choose one depending on your setup:
#
# Local Supabase CLI (supabase start):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
#   DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
#
# Docker:
#   DATABASE_URL="postgresql://postgres:postgres@db:5432/morningmoney"
#   DIRECT_URL="postgresql://postgres:postgres@db:5432/morningmoney"
#
# Remote Supabase (public mode):
#   DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Public mode only ────────────────────────────────────────
# Only needed when NEXT_PUBLIC_APP_MODE=public:
# NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
# NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_PRICE_ID=""

# ── AI Analysis (required) ──────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Email (required for digests) ────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="Morning Money <daily@morning-money.app>"

# ── AWS S3 (optional, PDF storage) ──────────────────────────
# Omit to store PDFs as asx:// URL references
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Cron / worker shared secret ─────────────────────────────
# Used to secure the daily digest endpoint.
# Generate: openssl rand -hex 32
CRON_SECRET=""
