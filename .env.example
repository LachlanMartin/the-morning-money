# ── User ─────────────────────────────────────────────────────
# The email used to auto-create the single local user
LOCAL_USER_EMAIL=you@email.com

# ── Postgres ─────────────────────────────────────────────────
# Docker:
#   DATABASE_URL="postgresql://postgres:postgres@db:5432/morningmoney"
#   DIRECT_URL="postgresql://postgres:postgres@db:5432/morningmoney"
#
# Local (without Docker):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"
#   DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/morningmoney"

# ── AI Analysis (required) ──────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Email (required for digests) ────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="Morning Money <daily@morning-money.app>"

# ── AWS S3 (optional, PDF storage) ──────────────────────────
# Omit to store PDFs as asx:// URL references
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Cron / worker shared secret ─────────────────────────────
# Used to secure the daily digest endpoint.
# Generate: openssl rand -hex 32
CRON_SECRET=""
